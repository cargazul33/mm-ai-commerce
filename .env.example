# M&M AI Commerce — ZERO SPEND defaults
DATABASE_URL=sqlite:///./data/mm_commerce.db
MARGIN_MULTIPLIER=1.90
FIT_SCORE_ALERT_MIN=60
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
# Optional local LLM (never invent prices)
LLM_BASE_URL=
LLM_MODEL=
# CODINEU: path to login.env or leave empty → REQUIERE CREDENCIALES for private
CODINEU_LOGIN_ENV=/home/box/.config/codineu/login.env
CODINEU_FIXTURE=/workspace/codineu-vigentes.json
PLIEGOS_DIR=/workspace/pliegos
USE_FIXTURES=1
EXCLUDED_PROCESS_IDS=16514
